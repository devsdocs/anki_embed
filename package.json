{
	"name": "obsidian-anki-embed",
	"version": "1.0.0",
	"description": "Embed interactive Anki flashcard decks inside Obsidian notes via AnkiConnect.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --import jiti/register test/verify.test.ts",
		"lint": "tsc -noEmit -skipLibCheck"
	},
	"keywords": [
		"obsidian",
		"anki",
		"flashcards",
		"anki-connect",
		"embed"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3"
	}
}
